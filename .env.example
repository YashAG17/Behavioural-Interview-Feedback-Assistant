# ── Copy this file to .env and fill in your values ───────────────────────────

# Google Gemini API key (used if local Ollama is unavailable or returns invalid output)
GEMINI_API_KEY=your_gemini_api_key_here

# JWT secret (change this to a long random string in production)
SECRET_KEY=change-me-to-a-very-long-random-secret-string

# Optional overrides
# DATABASE_URL=sqlite:///../interview_app.db
# PostgreSQL example: postgresql+psycopg://user:password@localhost:5432/interview_app
# GEMINI_MODEL=gemini-3.8-flash
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:0.5b
# Optional Ollama Cloud fallback
# OLLAMA_API_KEY=your_ollama_api_key_here
# OLLAMA_CLOUD_MODEL=gemma4:31b
# OLLAMA_LOCAL_TIMEOUT_SECONDS=45
# OLLAMA_CLOUD_TIMEOUT_SECONDS=90
# ACCESS_TOKEN_EXPIRE_MINUTES=1440
# MIN_QUESTIONS=5
# MAX_QUESTIONS=15
# DEFAULT_QUESTIONS=5
